# Override the canonical site URL (used in sitemap, canonical tags, JSON-LD)
# Default: https://lakelureinsider.com
# Set this to your preview URL during staging
NEXT_PUBLIC_SITE_URL=https://lakelureinsider.com

# Contact form (src/app/api/contact/route.ts)
# Get RESEND_API_KEY from https://resend.com (free tier is plenty for this site)
# CONTACT_TO_EMAIL is where form submissions are delivered — kept server-only,
# never committed to this public repo, never sent to the browser.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
